#!/bin/bash
# ---------------------------------------------------------------------------
# save-config — 준비된 설정 내용을 설치 자리에 root:wheel 0644 로 놓는다.
#
# 설치 위치 : /usr/local/libexec/exem-wifi-switcher/save-config   (root:wheel 0755)
# 호출 형태 : save-config <준비된-json-파일> <그 내용의-SHA-256>
#             save-config --capabilities      (아는 계약을 알린다. root 가 필요 없다)
# 권한 경로 : **관리자 인증**(암호 입력)을 거쳐 root 로 실행된다.
#
#   ⚠️  이 스크립트를 /etc/sudoers.d 의 NOPASSWD 목록에 넣지 마라.
#
#       설정 파일을 root:wheel 0644 로 잠근 이유가 바로 "사용자 권한 프로세스가 값을
#       못 바꾸게" 하기 위해서다. 그 값(dns · router)은 무암호로 열려 있는 apply 를 통해
#       root 의 networksetup 인자가 된다. 저장 경로를 무암호로 열면 잠금이 통째로 무의미해지고,
#       암호를 모르는 코드가 시스템 DNS 와 기본 게이트웨이를 갈아치울 수 있다.
#
#       저장은 온보딩 1회성이라 인증을 받아도 UX 손해가 작다. 전환(apply)은 그대로 무암호다.
#
# 왜 지문(SHA-256)을 함께 받는가
#
#   앱은 내용을 임시 파일에 쓴 뒤 관리자 인증 창을 띄운다. 그 창은 **수 초간 떠 있고**,
#   임시 파일의 소유자는 root 가 아니라 로그인 사용자다. 그 사이에 같은 사용자로 도는 코드가
#   내용을 갈아 끼우면 모양 검사(JSON 파싱 · 키 존재)는 그대로 통과한다 — 공격자의 dns · router 가
#   root:wheel 0644 로 설치되고, 그 뒤로는 무암호로 열려 있는 apply 가 그 값을 계속 적용한다.
#   설정 파일을 잠근 것이 그 순간 무의미해진다.
#
#   지문은 **인증 창이 뜨기 전에** 명령 문자열에 박힌다. 파일 내용은 바꿀 수 있어도 이미 확정된
#   명령 인자는 바꿀 수 없다. 그래서 "무엇을 저장하는가" 가 인증 이전에 못 박힌다.
#
#   지문은 반드시 **실제로 설치할 바로 그 바이트**에서 다시 계산해야 한다. 경로를 다시 열어
#   계산하면 계산한 것과 설치하는 것이 갈라져 구멍이 그대로 남는다. 그래서 fd 를 먼저 잡고
#   root 전용 사본을 뜬 뒤, 대조도 모양 검사도 설치도 전부 그 사본에서만 한다 (apply 와 같은 방식).
#
#   지문 자체는 비밀이 아니다 (같은 기계의 다른 사용자가 ps 로 볼 수 있다). 비밀이 아니어도
#   되는 이유는, 막으려는 것이 "내용 바꿔치기" 이지 "내용 열람" 이 아니기 때문이다.
#
# 계약이 바뀌면 재설치가 필요하다
#
#   앱만 새로 받고 이 스크립트는 예전 것이 설치된 사용자가 생긴다. 예전 스크립트는 인자를
#   하나만 받으므로 지문을 넘기면 exit 2 로 죽는다 — 조용히 잘못 저장되지는 않는다.
#   앱은 인증 창을 띄우기 전에 `--capabilities` 로 그 사실을 미리 확인해 재설치를 안내한다.
#   반대로 이 스크립트에 인자를 하나만 넘기는 것은 **예전 앱**이다. 그 호출은 받지 않는다 —
#   받으면 지문 없는 옛 계약이 되살아나 위 방어가 통째로 사라진다.
#
# 되돌리기 : 설정 파일을 지우려면 ./scripts/uninstall.sh
#
# 종료 코드
#   0 성공 / 2 잘못된 인자 / 3 root 아님 / 4 내용 문제 / 5 설치 실패 / 6 지문 불일치
# ---------------------------------------------------------------------------

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
LC_ALL=C
export LC_ALL

CONFIG_DIR=/usr/local/etc/exem-wifi-switcher
CONFIG_FILE="$CONFIG_DIR/config.json"

# 설정 파일이 이만큼 커질 이유가 없다. 상한을 두어 엉뚱한 파일이 흘러드는 것을 막는다.
MAX_CONFIG_BYTES=65536

# 이 스크립트가 아는 계약. 앱이 인증 창을 띄우기 전에 이것을 묻는다.
CAPABILITIES=sha256

EXIT_USAGE=2
EXIT_NOT_ROOT=3
EXIT_CONTENT=4
EXIT_INSTALL=5
EXIT_DIGEST=6

err() { printf '%s\n' "$*" >&2; }
die() { local code="$1"; shift; err "$*"; exit "$code"; }

usage() {
    cat <<'USAGE'
사용법: save-config <준비된-json-파일> <그 내용의-SHA-256>
        save-config --capabilities

앱이 준비해 둔 설정 내용을 /usr/local/etc/exem-wifi-switcher/config.json 에
root:wheel 0644 로 놓는다. 관리자 인증을 거쳐 root 로 실행된다.

SHA-256 은 소문자 16진수 64자다 (shasum -a 256 <파일> 의 앞부분).
그 지문과 다른 내용은 설치하지 않는다 — 인증 창이 떠 있는 사이에 준비된 파일이
바뀌어도 저장되는 것은 앱이 저장하려던 내용뿐이다.
USAGE
}

# --- 안전성 -----------------------------------------------------------------

# 권한 비트가 root 외의 사용자에게 쓰기를 열어 주는가. 열려 있으면 0(참).
# 판독할 수 없는 값은 위험한 쪽으로 판정한다(fail closed).
mode_allows_foreign_write() {
    local perms="${1-}"
    if [[ ! "$perms" =~ ^[0-7]{3,5}$ ]]; then
        return 0
    fi
    if [ $(( 8#$perms & 8#0022 )) -ne 0 ]; then
        return 0
    fi
    return 1
}

assert_root_owned() {
    local path="$1" label="$2" owner perms
    if [ -L "$path" ]; then
        die "$EXIT_INSTALL" "$label 이 심볼릭 링크입니다: $path"
    fi
    if [ ! -e "$path" ]; then
        die "$EXIT_INSTALL" "$label 이 없습니다: $path"
    fi
    owner=$(stat -f '%u' "$path") || die "$EXIT_INSTALL" "$label 정보를 읽지 못했습니다: $path"
    if [[ ! "$owner" =~ ^[0-9]+$ ]] || [ "$owner" -ne 0 ]; then
        die "$EXIT_INSTALL" "$label 의 소유자가 root 가 아닙니다: $path (설치가 손상됐습니다)"
    fi
    perms=$(stat -f '%OLp' "$path") || die "$EXIT_INSTALL" "$label 의 권한을 읽지 못했습니다: $path"
    if mode_allows_foreign_write "$perms"; then
        die "$EXIT_INSTALL" "$label 을 root 외의 사용자가 쓸 수 있습니다: $path (권한 $perms)"
    fi
}

assert_self_is_safe() {
    local self="${BASH_SOURCE[0]}" directory
    directory=$(dirname "$self")
    assert_root_owned "$directory" "권한 스크립트 디렉터리"
    assert_root_owned "$self" "권한 스크립트"
}

# --- 준비된 내용 붙잡기 -------------------------------------------------------

# 준비된 파일을 **한 번만 열고**, 연 그 fd 에서 root 전용 사본을 뜬다.
# 이후의 대조·검사·설치는 전부 그 사본에서만 한다.
#
# 왜 이렇게 하는가: 경로를 stat 로 재고 plutil 로 다시 열고 install 로 또 여는 방식은,
# 검사와 사용 사이에 파일이 바뀔 수 있는 창을 여러 개 만든다(TOCTOU). 검사 직후 그 경로를
# root 전용 파일의 심링크로 바꾸면 root 가 그 내용을 0644 로 복사한다.
# 여기서는 fd 를 먼저 잡고 `/dev/fd` 로 **그 fd** 를 재므로, 잰 대상과 설치하는 대상이 같다.
#
# 남는 것 하나: `[ -f ]` 검사와 `exec 9<` 사이에 경로를 FIFO 로 바꾸면 여는 자리에서 멈춘다.
# 그것으로 얻는 것은 설치가 되지 않는 것뿐이고(내용은 지문에 묶여 있다), 사용자가 인증 창을
# 다시 띄우면 끝난다. 셸에서 O_NONBLOCK 으로 여는 길이 없어 여기까지가 이 자리의 한계다.
SOURCE_SNAPSHOT=""
SOURCE_SNAPSHOT_DIR=""

remove_source_snapshot() {
    if [ -n "$SOURCE_SNAPSHOT_DIR" ]; then
        rm -rf -- "$SOURCE_SNAPSHOT_DIR"
        SOURCE_SNAPSHOT_DIR=""
    fi
}

open_source_snapshot() {
    local source="$1" kind size

    SOURCE_SNAPSHOT_DIR=$(umask 077; mktemp -d -t exem-wifi-switcher-save) \
        || die "$EXIT_INSTALL" "설정을 옮겨 둘 임시 자리를 만들지 못했습니다"
    trap remove_source_snapshot EXIT
    SOURCE_SNAPSHOT="$SOURCE_SNAPSHOT_DIR/config.json"

    exec 9<"$source" || die "$EXIT_USAGE" "준비된 파일을 열지 못했습니다: $source"

    kind=$(stat -f '%HT' /dev/fd/9) || { exec 9<&-; die "$EXIT_USAGE" "준비된 파일 정보를 읽지 못했습니다: $source"; }
    if [ "$kind" != "Regular File" ]; then
        exec 9<&-
        die "$EXIT_USAGE" "준비된 파일이 일반 파일이 아닙니다: $source ($kind)"
    fi
    size=$(stat -f '%z' /dev/fd/9) || { exec 9<&-; die "$EXIT_USAGE" "준비된 파일의 크기를 읽지 못했습니다: $source"; }
    if [[ ! "$size" =~ ^[0-9]+$ ]] || [ "$size" -lt 2 ] || [ "$size" -gt "$MAX_CONFIG_BYTES" ]; then
        exec 9<&-
        die "$EXIT_USAGE" "준비된 파일의 크기가 설정 파일 범위를 벗어납니다 ($size 바이트)"
    fi

    cat <&9 > "$SOURCE_SNAPSHOT" || { exec 9<&-; die "$EXIT_USAGE" "준비된 파일을 읽지 못했습니다: $source"; }
    exec 9<&-

    if [ ! -s "$SOURCE_SNAPSHOT" ]; then
        die "$EXIT_USAGE" "준비된 파일이 비어 있습니다: $source"
    fi
}

# --- 지문 대조 ---------------------------------------------------------------

# 파일 하나의 SHA-256 을 소문자 16진수로 찍는다. 둘 다 macOS 기본 설치에 있는 도구다 —
# 하나가 사라지는 날(shasum 은 perl 위에 있다) 저장이 통째로 막히지 않도록 순서대로 시도하고,
# 둘 다 없으면 **아무것도 설치하지 않고** 죽는다(fail closed).
#
# 파일은 인자로 주지 않고 stdin 으로 흘린다. openssl 의 dgst 는 `--` 를 모르고(2026-08-03 실측,
# LibreSSL), 그러면 `-` 로 시작하는 경로가 옵션으로 읽힌다. 흘려 넣으면 그 문제가 아예 없고
# 두 도구의 출력 형태가 같아 읽는 자리도 하나로 남는다:
#
#   shasum -a 256            → '<지문>  -'
#   openssl dgst -sha256 -r  → '<지문> *stdin'
file_digest() {
    local path="$1" line digest
    line=$(shasum -a 256 < "$path" 2>/dev/null) || line=""
    if [ -z "$line" ]; then
        line=$(openssl dgst -sha256 -r < "$path" 2>/dev/null) || line=""
    fi
    digest=${line%% *}
    if [[ ! "$digest" =~ ^[0-9a-f]{64}$ ]]; then
        return 1
    fi
    printf '%s' "$digest"
}

# 넘어온 것이 **앱이 저장하려던 바로 그 내용**인가.
# 인자로 받는 경로는 언제나 root 전용 사본이다 (원본 경로를 다시 열지 않는다).
assert_content_matches() {
    local path="$1" expected="$2" actual
    actual=$(file_digest "$path") \
        || die "$EXIT_DIGEST" "설정 내용의 지문을 계산하지 못해 저장하지 않았습니다"
    if [ "$actual" != "$expected" ]; then
        die "$EXIT_DIGEST" "준비된 내용이 앱이 저장하려던 것과 다릅니다. 저장하지 않았습니다.
인증을 기다리는 사이에 파일이 바뀌었을 수 있습니다 — 설정 창에서 다시 저장하세요."
    fi
}

# --- 내용 검사 ---------------------------------------------------------------

# 넘어온 파일이 정말 "설정 파일" 인지 본다. 값 하나하나의 옳고 그름은 apply 가 적용 직전에
# 다시 판단하므로, 여기서는 **모양**만 확인한다 — 엉뚱한 파일이 설치 자리에 놓이는 것을 막는다.
#
# 지문 대조를 통과했다면 이 검사는 앱이 넘긴 내용에 대해서는 이미 앱이 한 검증의 되풀이다.
# 그래도 남겨 둔다 — 터미널에서 손으로 부르는 길(`sudo save-config <파일> <지문>`)에는
# 앱의 검증이 없고, 그 길로도 설치 자리에 놓이는 것은 같은 파일이다.
assert_looks_like_config() {
    local path="$1" count

    # `plutil -lint` 는 확장자와 무관하게 옛 plist 문법으로 먼저 읽으려 해서 JSON 을 거부한다.
    # 파싱 자체가 되는지는 변환을 시켜 보는 쪽이 정확하다 (출력은 버린다).
    if ! plutil -convert json -o /dev/null -- "$path" >/dev/null 2>&1; then
        die "$EXIT_CONTENT" "설정 내용이 올바른 JSON 이 아닙니다"
    fi
    if ! plutil -extract service raw -o - -- "$path" >/dev/null 2>&1; then
        die "$EXIT_CONTENT" "설정에 service 항목이 없습니다"
    fi
    if ! plutil -extract defaultProfile raw -o - -- "$path" >/dev/null 2>&1; then
        die "$EXIT_CONTENT" "설정에 defaultProfile 항목이 없습니다"
    fi
    count=$(plutil -extract profiles raw -o - -- "$path" 2>/dev/null) \
        || die "$EXIT_CONTENT" "설정에 profiles 목록이 없습니다"
    if [[ ! "$count" =~ ^[0-9]+$ ]] || [ "$count" -lt 1 ]; then
        die "$EXIT_CONTENT" "설정에 프로필이 하나도 없습니다"
    fi
}

# --- 본체 -------------------------------------------------------------------

main() {
    if [ $# -eq 1 ]; then
        case "$1" in
            --help|-h)
                usage
                return 0
                ;;
            --capabilities)
                printf '%s\n' "$CAPABILITIES"
                return 0
                ;;
        esac
    fi
    if [ $# -ne 2 ]; then
        usage >&2
        die "$EXIT_USAGE" "인자는 준비된 JSON 파일 경로와 그 내용의 SHA-256 두 개여야 합니다 (받은 인자 수: $#).
인자를 하나만 넘겼다면 앱이 예전 버전입니다 — 새 앱으로 저장하세요."
    fi

    local source="$1" expected="$2"
    case "$source" in
        /*) ;;
        *) die "$EXIT_USAGE" "절대 경로여야 합니다: '$source'" ;;
    esac
    # 지문도 인증 창 뒤에서 도는 명령의 인자다. 허용 문자만 통과시킨다(앱의 검사와 같은 규칙).
    if [[ ! "$expected" =~ ^[0-9a-f]{64}$ ]]; then
        die "$EXIT_USAGE" "SHA-256 은 소문자 16진수 64자여야 합니다 (받은 길이: ${#expected})"
    fi

    if [ "$(id -u)" -ne 0 ]; then
        die "$EXIT_NOT_ROOT" "이 스크립트는 root 로 실행해야 합니다 (앱이 관리자 인증을 거쳐 호출합니다)"
    fi

    assert_self_is_safe

    # 준비된 파일은 사용자가 만든 것이다. 심링크·특수 파일을 그대로 받지 않는다.
    # 이 두 검사는 정직한 실수를 일찍 걸러 낼 뿐이고, 바꿔치기를 막는 것은 아래의 fd 사본과 지문이다.
    if [ -L "$source" ]; then
        die "$EXIT_USAGE" "준비된 파일이 심볼릭 링크입니다: $source"
    fi
    if [ ! -f "$source" ]; then
        die "$EXIT_USAGE" "준비된 파일이 없거나 일반 파일이 아닙니다: $source"
    fi

    open_source_snapshot "$source"
    assert_content_matches "$SOURCE_SNAPSHOT" "$expected"
    assert_looks_like_config "$SOURCE_SNAPSHOT"

    # 설정 디렉터리는 root:wheel 0755 여야 한다. 없으면 만들고, 있으면 권한을 맞춘다.
    if [ ! -d "$CONFIG_DIR" ]; then
        /usr/bin/install -d -o root -g wheel -m 0755 "$CONFIG_DIR" \
            || die "$EXIT_INSTALL" "설정 디렉터리를 만들지 못했습니다: $CONFIG_DIR"
    else
        if [ -L "$CONFIG_DIR" ]; then
            die "$EXIT_INSTALL" "설정 디렉터리가 심볼릭 링크입니다: $CONFIG_DIR"
        fi
        chown root:wheel "$CONFIG_DIR" || die "$EXIT_INSTALL" "설정 디렉터리 소유자를 맞추지 못했습니다"
        chmod 0755 "$CONFIG_DIR" || die "$EXIT_INSTALL" "설정 디렉터리 권한을 맞추지 못했습니다"
    fi

    if [ -L "$CONFIG_FILE" ]; then
        die "$EXIT_INSTALL" "설정 파일 자리가 심볼릭 링크입니다: $CONFIG_FILE"
    fi

    # install(1) 은 임시 파일에 쓴 뒤 자리를 바꾼다 — 쓰는 도중에 apply 가 읽어도
    # 반쯤 쓰인 JSON 을 보지 않는다.
    # 놓는 것은 **지문을 대조한 그 사본**이다. 원본 경로를 다시 열지 않는다.
    /usr/bin/install -o root -g wheel -m 0644 "$SOURCE_SNAPSHOT" "$CONFIG_FILE" \
        || die "$EXIT_INSTALL" "설정 파일을 놓지 못했습니다: $CONFIG_FILE"

    printf '설정을 저장했습니다: %s (root:wheel 0644)\n' "$CONFIG_FILE"
    return 0
}

# 테스트에서 이 파일을 source 해 개별 검증 함수를 직접 호출한다.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    set -euo pipefail
    IFS=$' \t\n'
    main "$@"
fi
